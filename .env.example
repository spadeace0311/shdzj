POSTGRES_DB=earthquake
POSTGRES_USER=earthquake
POSTGRES_PASSWORD=replace-this-before-deployment
DATABASE_URL=postgresql+asyncpg://earthquake:replace-this-before-deployment@postgres:5432/earthquake
API_BIND_HOST=127.0.0.1
API_PORT=8000
JWT_SECRET=replace-this-before-deployment
JWT_EXPIRE_MINUTES=480
SUPERADMIN_USERNAME=superadmin
SUPERADMIN_INITIAL_PASSWORD=replace-this-before-deployment
# Collector is disabled for API and test processes; Compose enables it for the collector service.
CENC_COLLECTOR_ENABLED=false
# Canonical FAN Studio client identifier. If blank, CENC_APP_ID is used as the legacy fallback.
FAN_APP_ID=
# FAN Studio API key. Required by the collector; leave blank in source control.
FAN_API_KEY=
# Legacy FAN Studio client identifier fallback. This is not a CENC/Kanameishi credential.
CENC_APP_ID=
# Reserved for a future private CENC adapter; the current collector does not call this URL.
CENC_API_BASE_URL=https://replace-with-cenc-adapter-host
FAN_WS_PRIMARY_URL=wss://ws.fanstudio.tech/all
FAN_WS_BACKUP_URL=wss://ws.fanstudio.hk/all
FAN_QUERY_INTERVAL_SECONDS=10
WOLFX_CENC_URL=https://api.wolfx.jp/cenc_eqlist.json
WOLFX_POLL_INTERVAL_SECONDS=10
CENC_BOOTSTRAP_LOOKBACK_HOURS=24
COLLECTOR_STALE_AFTER_SECONDS=60
COLLECTOR_SPOOL_DIR=/var/lib/collector-spool
COLLECTOR_MAX_SPOOL_BYTES=1073741824
RESPONSE_RULES_PATH=/config/response_rules/shanghai-2026.yaml
TEMPORAL_ADDRESS=temporal:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=assessment
TEMPORAL_UI_BIND_HOST=127.0.0.1
TEMPORAL_UI_PORT=8088
# The API and worker processes must not run the outbox dispatcher.
ASSESSMENT_DISPATCHER_ENABLED=false
ASSESSMENT_OUTBOX_POLL_SECONDS=1
ASSESSMENT_OUTBOX_BATCH_SIZE=20
ASSESSMENT_OUTBOX_MAX_ATTEMPTS=10
ASSESSMENT_OUTBOX_LEASE_SECONDS=60
INTENSITY_PARAMETERS_PATH=/config/intensity/shanghai-2019.yaml
INTENSITY_REGION_PROFILE_PATH=/config/intensity/shanghai-region.yaml
ASSESSMENT_WORKFLOW_SAFETY_TIMEOUT_SECONDS=1800
