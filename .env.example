POSTGRES_DB=earthquake
POSTGRES_USER=earthquake
POSTGRES_PASSWORD=replace-this-before-deployment
POSTGRES_HOST_PORT=5432
DATABASE_URL=postgresql+asyncpg://earthquake:replace-this-before-deployment@postgres:5432/earthquake
API_BIND_HOST=127.0.0.1
API_PORT=8000
JWT_SECRET=replace-this-before-deployment
JWT_EXPIRE_MINUTES=480
SUPERADMIN_USERNAME=superadmin
SUPERADMIN_INITIAL_PASSWORD=replace-this-before-deployment
# Collector is disabled for API and test processes; Compose enables it for the collector service.
CENC_COLLECTOR_ENABLED=false
# Canonical FAN Studio client identifier. If blank, CENC_APP_ID is used as the legacy fallback.
FAN_APP_ID=
# FAN Studio API key. Required by the collector; leave blank in source control.
FAN_API_KEY=
# Legacy FAN Studio client identifier fallback. This is not a CENC/Kanameishi credential.
CENC_APP_ID=
# Reserved for a future private CENC adapter; the current collector does not call this URL.
CENC_API_BASE_URL=https://replace-with-cenc-adapter-host
FAN_WS_PRIMARY_URL=wss://ws.fanstudio.tech/all
FAN_WS_BACKUP_URL=wss://ws.fanstudio.hk/all
FAN_QUERY_INTERVAL_SECONDS=10
WOLFX_CENC_URL=https://api.wolfx.jp/cenc_eqlist.json
WOLFX_POLL_INTERVAL_SECONDS=10
CENC_BOOTSTRAP_LOOKBACK_HOURS=24
COLLECTOR_STALE_AFTER_SECONDS=60
COLLECTOR_SPOOL_DIR=/var/lib/collector-spool
COLLECTOR_MAX_SPOOL_BYTES=1073741824
RESPONSE_RULES_PATH=/config/response_rules/shanghai-2026.yaml
TEMPORAL_ADDRESS=temporal:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=assessment
TEMPORAL_UI_BIND_HOST=127.0.0.1
TEMPORAL_UI_PORT=8088
# The API and worker processes must not run the outbox dispatcher.
ASSESSMENT_DISPATCHER_ENABLED=false
ASSESSMENT_OUTBOX_POLL_SECONDS=1
ASSESSMENT_OUTBOX_BATCH_SIZE=20
ASSESSMENT_OUTBOX_MAX_ATTEMPTS=10
ASSESSMENT_OUTBOX_LEASE_SECONDS=60
INTENSITY_PARAMETERS_PATH=/config/intensity/shanghai-2019.yaml
INTENSITY_REGION_PROFILE_PATH=/config/intensity/shanghai-region.yaml
ASSESSMENT_WORKFLOW_SAFETY_TIMEOUT_SECONDS=1800
DATA_ASSET_REGION_ID=shanghai
DATA_ASSET_REQUIRED_REGISTRY_PATH=/config/data_assets/shanghai-required-assets.yaml
DATA_ASSET_COVERAGE_POLICY_PATH=/config/data_assets/shanghai-coverage-policy.yaml
DATA_ASSET_STORAGE_ROOT=/var/lib/data-assets
DATA_ASSET_STORAGE_HOST_DIR=../data/data-assets
DATA_ASSET_MAX_UPLOAD_BYTES=1073741824
DATA_ASSET_MDB_DRIVER=Microsoft Access Driver (*.mdb, *.accdb)
DATA_ASSET_WORKER_POLL_SECONDS=1.0
ARTIFACT_STORAGE_ROOT=/var/lib/artifacts
ARTIFACT_TEMPLATE_ROOT=/config/artifacts/templates
ARTIFACT_CATALOG_PATH=/config/artifacts/catalog.yaml
ARTIFACT_MAX_OVERRIDE_BYTES=1073741824
ARTIFACT_RENDER_CONCURRENCY=4
ARTIFACT_OPTIONAL_DEPENDENCY_RESERVE_SECONDS=30
ARTIFACT_BROWSER_POOL_SIZE=2
COLLABORATION_TASK_TEMPLATE_PATH=/config/collaboration/shanghai-2026-tasks.yaml
COLLABORATION_WORKER_ENABLED=false
COLLABORATION_WORKER_POLL_SECONDS=1.0
COLLABORATION_WORKER_BATCH_SIZE=50
COLLABORATION_OUTBOX_MAX_ATTEMPTS=10
COLLABORATION_OUTBOX_LEASE_SECONDS=60
KNOWLEDGE_STORAGE_ROOT=/var/lib/knowledge
KNOWLEDGE_STORAGE_HOST_DIR=../data/knowledge
KNOWLEDGE_MAX_UPLOAD_BYTES=1073741824
KNOWLEDGE_WORKER_POLL_SECONDS=1.0
KNOWLEDGE_WORKER_BATCH_SIZE=20
KNOWLEDGE_WORKER_HEALTH_URL=http://knowledge-worker:8100
KNOWLEDGE_WORKER_HEALTH_PORT=8100
KNOWLEDGE_ONLINE_REFRESH_INTERVAL_SECONDS=86400
KNOWLEDGE_JOB_MAX_ATTEMPTS=5
KNOWLEDGE_JOB_LEASE_SECONDS=120
QDRANT_URL=http://qdrant:6333
QDRANT_COLLECTION_PREFIX=shanghai-knowledge
EMBEDDING_SERVICE_URL=http://embedding:8080
EMBEDDING_MODEL_NAME=BAAI/bge-m3
RERANKER_MODEL_NAME=BAAI/bge-reranker-v2-m3
EMBEDDING_DEVICE=cpu
EMBEDDING_BATCH_SIZE=16
ONLINE_SEARCH_ENABLED=false
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_API_KEY=
DEEPSEEK_TIMEOUT_SECONDS=60
DEEPSEEK_MAX_RETRIES=2
QA_TOOL_TIMEOUT_SECONDS=1.5
QA_MAX_PARALLEL_TOOLS=6
